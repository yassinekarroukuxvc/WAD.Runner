# SolidWorks macros are ignored by default unless they are template/source assets
*.swp

# Keep all source templates versioned
!Resources/
!Resources/Templates/
!Resources/Templates/**
!**/Resources/Templates/
!**/Resources/Templates/**

# Keep shared SolidWorks interop libraries versioned
!Resources/Solidworks/
!Resources/Solidworks/*.dll

# Keep source config files versioned
!Resources/Config/
!Resources/Config/*.json

# Keep database schema versioned, but not local database files
!Resources/Database/
!Resources/Database/scheme.sql

# NuGet package cache should stay outside repo
packages/
.nuget/

